{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "baseUrl": "./",
    "paths": {
      "@tests/*": ["tests/*"],
      "@config/*": ["src/config/*"],
      "@modules/*": ["src/modules/*"],
      "@cache/*": ["src/modules/cache/*"],
      "@health/*": ["src/modules/health/*"],
      "@performance/*": ["src/modules/performance/*"],
      "@curso-completo/*": ["src/modules/curso-completo/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "ts-node": {
    "files": true
  }
}