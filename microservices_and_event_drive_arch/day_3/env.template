# =======================
# Environment Template
# Copy to .env and adjust values
# =======================

# App
NODE_ENV=production
PORT=8080

# Service Discovery -- API Gateway
SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0
INSTANCE_ID=${HOSTNAME:-local}-1
SERVICE_HOST=localhost
SERVICE_PORT=3001
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_DOMAIN=e-learning
SERVICE_RATE_LIMIT_PER_MINUTE=600

# Consul Configuration
CONSUL_HTTP_ADDR=http://consul:8500
SERVICE_ENV=local

# API Gateway Configuration
API_GATEWAY_PORT=3001

# Curso Completo Microservice Configuration
CURSO_COMPLETO_PORT=3002
CURSO_COMPLETO_SERVICE_NAME=course-service 
CURSO_COMPLETO_HEALTH_PATH=/health
CURSO_COMPLETO_HEALTH_INTERVAL=10s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=elearning_dev
DB_SSL=false

# Message Broker - RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=password
RABBITMQ_VHOST=/

# TypeORM logging levels (comma separated). In prod usually only error
TYPEORM_LOGGING=error

# Caching (optional override)
CACHE_DURATION_MS=3000

# Connection pool (example tuning)
TYPEORM_MAX_CONNECTIONS=10
TYPEORM_IDLE_TIMEOUT=30000

# Misc
# SENTRY_DSN=your_sentry_dsn
# NEW_RELIC_LICENSE_KEY=your_new_relic_key

# Security
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_MAX=100

# Feature flags
# FEATURE_ENABLE_NEW_CHECKOUT=false
