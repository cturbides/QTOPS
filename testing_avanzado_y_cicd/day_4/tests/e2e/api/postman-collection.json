    {
      "name": "Crear Curso Completo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response time is less than 2000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test('Curso created with all data', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('titulo');",
              "    pm.expect(jsonData).to.have.property('instructor');",
              "    pm.expect(jsonData).to.have.property('etiquetas');",
              "    pm.globals.set('cursoId', jsonData.id);",
              "});",
              "",
              "pm.test('Curso linked to instructor correctly', function () {",
              "    const jsonData = pm.response.json();",
              "    const instructorId = pm.globals.get('instructorId');",
              "    pm.expect(jsonData.instructor.id).to.eql(instructorId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Curso Newman E2E {{$timestamp}}\",\n  \"descripcion\": \"Curso creado durante pruebas automatizadas con Newman\",\n  \"instructorId\": \"{{instructorId}}\",\n  \"etiquetaIds\": [\"{{etiquetaId}}\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cursos",
          "host": ["{{baseUrl}}"],
          "path": ["cursos"]
        }
      }
    },
    {
      "name": "Obtener Curso Creado",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is less than 500ms', function () {",
