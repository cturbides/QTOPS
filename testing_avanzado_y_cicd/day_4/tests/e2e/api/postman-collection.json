  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is less than 500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test('Health status is ok', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});",
              "",
              "pm.test('Has health checks', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('info');",
              "    pm.expect(jsonData).to.have.property('details');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Crear Instructor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response time is less than 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test('Instructor created with ID', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.id).to.be.a('string');",
              "    pm.globals.set('instructorId', jsonData.id);",
              "});",
              "",
              "pm.test('Instructor has correct data', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.nombre).to.eql('Instructor E2E Newman');",
              "    pm.expect(jsonData.email).to.include('newman');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Instructor E2E Newman\",\n  \"email\": \"instructor-newman-{{$timestamp}}@test.com\",\n  \"biografia\": \"Instructor creado durante pruebas Newman E2E\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cursos/instructores",
          "host": ["{{baseUrl}}"],
          "path": ["cursos", "instructores"]
        }
      }
    },
