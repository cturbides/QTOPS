      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cursos/{{cursoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cursos", "{{cursoId}}"]
        }
      }
    },
    {
      "name": "Búsqueda Avanzada de Cursos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is less than 800ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(800);",
              "});",
              "",
              "pm.test('Search response structure is correct', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test('Search performance is acceptable', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test('Cursos array has correct structure', function () {",
              "    const jsonData = pm.response.json();",
              "    if (jsonData.length > 0) {",
              "        const primerCurso = jsonData[0];",
              "        pm.expect(primerCurso).to.have.property('id');",
              "        pm.expect(primerCurso).to.have.property('titulo');",
              "        pm.expect(primerCurso).to.have.property('instructor');",
              "        pm.expect(primerCurso).to.have.property('etiquetas');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cursos/search/advanced?textoBusqueda=Newman&limit=10&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["cursos", "search", "advanced"],
          "query": [
            {
              "key": "textoBusqueda",
              "value": "Newman"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      }
    },
