{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@api-gateway/*": ["apps/api-gateway/src/*"],
      "@curso-completo/*": ["apps/curso-completo-ms/src/*"],
      "@shared-modules/*": ["apps/shared-modules/*"],
      "@cache/*": ["apps/shared-modules/cache/*"],
      "@health/*": ["apps/shared-modules/health/*"],
      "@performance/*": ["apps/shared-modules/performance/*"],
      "@service-discovery/*": ["apps/shared-modules/service-discovery/*"],
      "@chaos/*": ["apps/shared-modules/chaos/*"]
    }
  },
  "include": [
    "apps/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}