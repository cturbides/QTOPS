{
  "name": "day_5",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:contract": "jest --selectProjects contract",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:pyramid": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run --reporters clear-text,dashboard",
    "test:complete": "npm run test:pyramid && npm run test:mutation && npm run test:all-containers",
    "test:testcontainers": "jest --selectProjects integration --testNamePattern='Test Containers'",
    "test:with-containers": "jest tests/integration/curso-completo.testcontainers.spec.ts",
    "test:simple-containers": "jest tests/integration/simple-integration.testcontainers.spec.ts",
    "test:all-containers": "jest tests/integration/*.testcontainers.spec.ts",
    "test:performance": "jest tests/integration/performance.testcontainers.spec.ts",
    "test:e2e": "npm run test:e2e:playwright && npm run test:e2e:cypress",
    "test:e2e:playwright": "playwright test",
    "test:e2e:cypress": "cypress run",
    "test:e2e:api": "newman run tests/e2e/api/postman-collection.json",
    "test:performance:artillery": "artillery run tests/e2e/performance/artillery-load-test.yml",
    "test:performance:autocannon": "node tests/e2e/performance/autocannon-stress-test.js",
    "test:e2e:full": "npm run test:e2e && npm run test:performance:artillery && npm run test:performance:autocannon",
    "test:accessibility": "node tests/e2e/accessibility/accessibility-check.js",
    "test:cross-browser": "npm run test:cross-browser:chrome && npm run test:cross-browser:firefox && npm run test:cross-browser:webkit",
    "test:cross-browser:chrome": "playwright test --project=chromium tests/e2e/cross-browser/",
    "test:cross-browser:firefox": "playwright test --project=firefox tests/e2e/cross-browser/",
    "test:cross-browser:webkit": "playwright test --project=webkit tests/e2e/cross-browser/",
    "test:inclusive": "npm run test:accessibility && npm run test:cross-browser",
    "test:complete:inclusive": "npm run test:e2e:full && npm run test:inclusive",
    "build": "npm run build:api-gateway && npm run build:curso-completo",
    "build:api-gateway": "nest build api-gateway",
    "build:curso-completo": "nest build curso-completo-ms",
    "build:prod": "npm run build && npm run test:ci",
    "docker:build": "docker build -t qtops/api-gateway:latest -f docker/Dockerfile.api-gateway . && docker build -t qtops/curso-completo:latest -f docker/Dockerfile.curso-completo .",
    "docker:push": "docker push qtops/api-gateway:latest && docker push qtops/curso-completo:latest",
    "test:all": "npm run test:pyramid && npm run test:mutation && npm run test:e2e:full",
    "lint": "eslint \"apps/**/*.ts\" --fix",
    "security:audit": "npm audit --audit-level moderate",
    "dev:consul": "docker compose up consul -d",
    "start:dev:api-gateway": "nest start --watch api-gateway",
    "migration:create": "npm run typeorm -- migration:create",
    "health:curl": "curl -s localhost:${PORT:-3000}/health | jq .",
    "start:dev:curso-completo": "nest start --watch curso-completo-ms",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:run": "npm run typeorm -- migration:run -d apps/curso-completo-ms/src/database/config/database.ts",
    "seed:run": "ts-node -r tsconfig-paths/register apps/curso-completo-ms/src/database/seeders/index.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d apps/curso-completo-ms/src/database/config/database.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d apps/curso-completo-ms/src/database/config/database.ts",
    "observability:start": "docker-compose -f docker-compose.observability.yml up -d",
    "observability:stop": "docker-compose -f docker-compose.observability.yml down",
    "observability:logs": "docker-compose -f docker-compose.observability.yml logs -f",
    "dev:full": "npm run observability:start && npm run start:dev:api-gateway & npm run start:dev:curso-completo",
    "infra:start": "docker compose up consul postgres rabbitmq -d",
    "infra:stop": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/axios": "^3.1.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/exporter-jaeger": "^1.17.0",
    "@opentelemetry/instrumentation-http": "^0.45.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.33.0",
    "@opentelemetry/sdk-node": "^0.45.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.1.0",
    "amqplib": "^0.10.9",
    "axios": "^1.6.2",
    "cache-manager": "^7.1.1",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "consul": "^0.40.0",
    "dotenv": "^17.2.1",
    "ioredis": "^5.7.0",
    "kafkajs": "^2.2.4",
    "nest": "^0.1.6",
    "nestjs": "^0.0.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "state-machine": "^1.0.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.26",
    "typescript": "^5.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nestjs/testing": "^11.1.6",
    "@pact-foundation/pact": "^15.0.1",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "^9.1.1",
    "@stryker-mutator/jest-runner": "^9.1.1",
    "@stryker-mutator/typescript-checker": "^9.1.1",
    "@testcontainers/postgresql": "^11.5.1",
    "@testcontainers/redis": "^11.5.1",
    "@types/cache-manager-ioredis": "^2.0.7",
    "@types/consul": "^0.40.3",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "artillery": "^2.0.24",
    "autocannon": "^8.0.0",
    "axe-core": "^4.10.3",
    "axe-playwright": "^2.1.0",
    "cypress": "^15.1.0",
    "eslint": "^9.34.0",
    "jest": "^30.1.3",
    "jest-mock-extended": "^4.0.0",
    "loadtest": "^8.2.0",
    "newman": "^6.2.1",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.4",
    "ts-mockito": "^2.6.1"
  }
}
