{
  "dashboard": {
    "id": null,
    "title": "E-Learning Enrollment Metrics",
    "tags": ["microservices", "elearning"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Enrollment Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(enrollment_operations_total{status=\"success\"}[5m]) / rate(enrollment_operations_total[5m])",
            "format": "time_series",
            "legendFormat": "Success Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Enrollment Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(enrollment_duration_seconds_bucket[5m]))",
            "format": "time_series",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(enrollment_duration_seconds_bucket[5m]))",
            "format": "time_series",
            "legendFormat": "50th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Saga Steps Status",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(saga_steps_total[5m])",
            "format": "time_series",
            "legendFormat": "{{step}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Circuit Breaker Status",
        "type": "graph",
        "targets": [
          {
            "expr": "circuit_breaker_state",
            "format": "time_series",
            "legendFormat": "{{target_service}} state"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 5,
        "title": "HTTP Request Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "format": "time_series",
            "legendFormat": "{{service}} - {{route}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  }
}
